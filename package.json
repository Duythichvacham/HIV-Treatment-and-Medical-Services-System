{
  "name": "hiv-clinic-app",
  "version": "1.0.0",
  "description": "HIV Clinic Management System - Full Stack Application",
  "scripts": {
    "start": "npm run dev",
    "download": "npm run clean && npm run install-all",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "build": "npm run build:client",
    "build:client": "cd client && npm run build",
    "preview": "cd client && npm run preview",
    "install-server": "cd server && npm install",
    "install-client": "cd client && npm install",
    "install-all": "npm install && npm run install-server && npm run install-client",
    "clean": "npm run clean:client && npm run clean:server",
    "clean:client": "cd client && npm run clean",
    "clean:server": "cd server && rm -rf node_modules/.cache"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@peculiar/webcrypto": "^1.5.0",
    "all": "^0.0.0",
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.4.2",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "handlebar": "^1.0.0",
    "html-to-text": "^9.0.5",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.0",
    "node-fetch": "^3.3.2",
    "prop-types": "^15.8.1",
    "quill": "^2.0.2",
    "react-chartjs-2": "^5.2.0",
    "react-html-parser": "^2.0.2",
    "redis": "^5.5.6",
    "vnpay": "^2.4.0"
  }
}
