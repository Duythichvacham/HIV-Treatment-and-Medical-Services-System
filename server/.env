# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=5000
NODE_ENV=development 

# ===========================================
# SQL SERVER CONFIGURATION
# ===========================================
DB_HOST=localhost
DB_PORT=1433
DB_NAME=HIV_HEALTH_CARE
DB_USER=sa
DB_PASSWORD=12345
DB_DIALECT=mssql
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# ===========================================
# JWT CONFIGURATION
# ===========================================
JWT_SECRET= super_secret_key_123456 # mã bí mật dùng để mã hóa JWT sẽ tính sau :V 
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET= another_secret_key_7890# mã bí mật dùng để mã hóa JWT Refresh sẽ tính sau :V
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# APPLICATION SETTINGS
# ===========================================
BCRYPT_SALT_ROUNDS=12 #độ phức tạp mã hóa mật khẩu là 12
API_PREFIX=/api/v1 #tiền tố của API
CORS_ORIGIN=http://localhost:3000 #địa chỉ frontend - chỉ thằng này được gọi API

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=info

# ===========================================
# Account email from server
