# ===========================================
# VITE ENVIRONMENT VARIABLES
# Lưu ý: Vite chỉ load variables có prefix VITE_ nên có thêm biến thì nhớ thêm VITE_ vào trước tên biến nha mấy bro:))
# ===========================================
# API CONFIGURATION
VITE_API_URL=http://localhost:2411/
VITE_API_TIMEOUT=10000
VITE_API_API_PREFIX=/api/v1
# APPLICATION SETTINGS
VITE_APP_NAME=HIV-Treatment-and-Medical-Services-System
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development

# FEATURES FLAGS
VITE_ENABLE_LOGGING=true
VITE_ENABLE_DEBUG=true
VITE_ENABLE_MOCK_API=false

# UPLOAD SETTINGS
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx